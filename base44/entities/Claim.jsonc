{
  "name": "Claim",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title / short description of the claim"
    },
    "claim_id": {
      "type": "string",
      "description": "Unique claim ID e.g. FSQA-2026-001"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "UNDER REVIEW",
        "RESOLVED",
        "CLOSED",
        "ON HOLD",
        "OPEN"
      ],
      "default": "UNDER REVIEW"
    },
    "fiscal_year": {
      "type": "number"
    },
    "date_of_claim": {
      "type": "string",
      "format": "date"
    },
    "date_received_by_fsqa": {
      "type": "string",
      "format": "date"
    },
    "date_of_claim_finalized": {
      "type": "string",
      "format": "date"
    },
    "claim_lifecycle": {
      "type": "string",
      "enum": [
        "CLAIM",
        "COMPLAINT",
        "INQUIRY"
      ],
      "default": "CLAIM"
    },
    "claim_conversion": {
      "type": "string"
    },
    "filing_amount": {
      "type": "number"
    },
    "amount_after_validation": {
      "type": "number"
    },
    "so_number": {
      "type": "string"
    },
    "po_number": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "primary_plant": {
      "type": "string"
    },
    "secondary_plant": {
      "type": "string"
    },
    "product_code": {
      "type": "string"
    },
    "proprietary_brand": {
      "type": "string"
    },
    "packaging_configuration": {
      "type": "string"
    },
    "product_category": {
      "type": "string"
    },
    "product_subcategory": {
      "type": "string"
    },
    "product_form": {
      "type": "string"
    },
    "lot_batch_number": {
      "type": "string"
    },
    "production_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "qty_cases_received": {
      "type": "string"
    },
    "qty_cases_at_hand": {
      "type": "string"
    },
    "total_shipment_qty": {
      "type": "string"
    },
    "qty_affected": {
      "type": "string"
    },
    "claim_quality_percentage": {
      "type": "number"
    },
    "root_cause_category": {
      "type": "string"
    },
    "claim_type": {
      "type": "string"
    },
    "claim_subtype": {
      "type": "string"
    },
    "additional_information": {
      "type": "string"
    },
    "attachments_available": {
      "type": "string"
    },
    "capa_report_created": {
      "type": "string"
    },
    "destination_region": {
      "type": "string"
    },
    "destination_country": {
      "type": "string"
    },
    "origin_region": {
      "type": "string"
    },
    "origin_country": {
      "type": "string"
    },
    "seller": {
      "type": "string"
    },
    "purchaser": {
      "type": "string"
    },
    "claims_rep": {
      "type": "string"
    },
    "third_party_surveyor": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "file_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}