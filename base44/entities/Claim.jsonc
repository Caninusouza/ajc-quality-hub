{
  "name": "Claim",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the quality claim"
    },
    "claim_number": {
      "type": "string",
      "description": "Unique claim reference number"
    },
    "type": {
      "type": "string",
      "enum": [
        "customer_complaint",
        "supplier_issue",
        "internal_nonconformance",
        "regulatory",
        "recall"
      ],
      "description": "Type of claim"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "corrective_action",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "product_name": {
      "type": "string",
      "description": "Affected product"
    },
    "batch_number": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the issue"
    },
    "root_cause": {
      "type": "string"
    },
    "corrective_action": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the person assigned"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "type",
    "severity"
  ]
}