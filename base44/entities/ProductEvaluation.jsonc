{
  "name": "ProductEvaluation",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "supplier_name": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_category": {
      "type": "string",
      "enum": [
        "Chicken",
        "Turkey",
        "Pork",
        "Beef",
        "Lamb",
        "Fish/Seafood",
        "Vegetables",
        "Fruits",
        "French Fries",
        "Other"
      ]
    },
    "plant_no": {
      "type": "string"
    },
    "product_code": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "pack": {
      "type": "string"
    },
    "special": {
      "type": "string"
    },
    "avg_live_wt_current": {
      "type": "string"
    },
    "avg_live_wt_target": {
      "type": "string"
    },
    "weekly_slaughter": {
      "type": "string"
    },
    "pack_date": {
      "type": "string",
      "format": "date"
    },
    "shelf_life": {
      "type": "string"
    },
    "notes_comments": {
      "type": "string"
    },
    "grading_profile": {
      "type": "string"
    },
    "piece_weights": {
      "type": "array",
      "description": "Individual piece weights in grams (50 for Chicken, 30 for Pork)",
      "items": {
        "type": "number"
      }
    },
    "label_photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "product_photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "transforms": {
            "type": "object",
            "properties": {
              "rotation": {
                "type": "number"
              },
              "flipH": {
                "type": "boolean"
              },
              "offsetX": {
                "type": "number"
              },
              "offsetY": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "grading_photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "supplier_name",
    "product_name",
    "date"
  ]
}