{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "quality_improvement",
        "compliance",
        "audit",
        "training",
        "process_optimization",
        "other"
      ],
      "default": "quality_improvement"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "in_progress",
        "on_hold",
        "completed",
        "cancelled"
      ],
      "default": "planning"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "owner": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "fsqa_assignee": {
      "type": "string",
      "description": "FSQA team member assigned to this project",
      "enum": [
        "Rafael Souza",
        "Gabriela Hidalgo"
      ]
    },
    "timelines": {
      "type": "array",
      "description": "4 project timeline steps",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ],
            "default": "pending"
          }
        }
      }
    },
    "file_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}