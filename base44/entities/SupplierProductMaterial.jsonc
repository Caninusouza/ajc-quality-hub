{
  "name": "SupplierProductMaterial",
  "type": "object",
  "properties": {
    "supplier_name": {
      "type": "string"
    },
    "plant_number": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_category": {
      "type": "string",
      "enum": [
        "Chicken",
        "Pork",
        "Beef",
        "Fish",
        "Turkey",
        "Vegetables",
        "Fruits",
        "French Fries",
        "Other"
      ]
    },
    "product_category_other": {
      "type": "string"
    },
    "product_cut": {
      "type": "string"
    },
    "brand_type": {
      "type": "string",
      "enum": [
        "Branded",
        "Unbranded"
      ],
      "description": "Whether the product is branded or unbranded"
    },
    "market_channel": {
      "type": "string",
      "enum": [
        "Retail",
        "Food Service"
      ],
      "description": "Retail or Food Service channel"
    },
    "primary_packaging_material": {
      "type": "string",
      "enum": [
        "Poly Bag",
        "Vacuum Bag",
        "Cryovac",
        "Tray",
        "Foam Tray",
        "Other"
      ],
      "description": "Material used for the primary (inner) package"
    },
    "primary_packaging_material_other": {
      "type": "string"
    },
    "primary_packaging_configuration": {
      "type": "string",
      "description": "e.g. 10 lb bag, individual piece vacuum"
    },
    "primary_packaging_weight": {
      "type": "string"
    },
    "primary_bag_type": {
      "type": "string",
      "enum": [
        "Printed",
        "Clear Poly",
        "N/A"
      ],
      "description": "If primary packaging is a bag, specify printed or clear poly"
    },
    "primary_recyclable": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Partially"
      ]
    },
    "secondary_packaging_material": {
      "type": "string",
      "enum": [
        "Cardboard Box",
        "Poly Bag",
        "Shrink Wrap",
        "Other"
      ],
      "description": "Material used for the secondary (outer/case) package"
    },
    "secondary_packaging_material_other": {
      "type": "string"
    },
    "secondary_packaging_configuration": {
      "type": "string",
      "description": "e.g. 4 bags per case, 40 lb case"
    },
    "secondary_packaging_weight": {
      "type": "string"
    },
    "secondary_recyclable": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Partially"
      ]
    },
    "palletization_configuration": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Approved",
        "Rejected"
      ],
      "default": "Draft"
    },
    "notes": {
      "type": "string"
    },
    "file_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "supplier_name",
    "product_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}